# ─── Anthropic ──────────────────────────────────────────────
# Для агентов и (опционально) живого режима дашборда
ANTHROPIC_API_KEY=your_key_here

# ─── Хильда · newsjacking ───────────────────────────────────
# Адрес, на который Хильда шлёт сводки (подставь свой)
OPERATOR_EMAIL=operator@example.com
# Веб-поиск (достаточно одного из двух)
BRAVE_API_KEY=your_key_here
TAVILY_API_KEY=your_key_here
# Gmail MCP (если используешь рассылку)
GMAIL_CLIENT_ID=your_id_here
GMAIL_CLIENT_SECRET=your_secret_here
GMAIL_REFRESH_TOKEN=your_token_here

# ─── Сага · адаптер под СМИ ─────────────────────────────────
# Проверка уникальности
TEXTRU_API_KEY=your_key_here
# Google Drive: ID папки для адаптаций + пути к файлам учёток (вне репозитория)
GDRIVE_OUTPUT_FOLDER_ID=your_folder_id_here
GDRIVE_CREDENTIALS_PATH=./credentials/gdrive-server-credentials.json
GDRIVE_OAUTH_PATH=./credentials/gcp-oauth.keys.json
